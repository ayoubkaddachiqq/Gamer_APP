<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane"
            prefHeight="800.0"
            prefWidth="1200.0"
            styleClass="app-shell"
            stylesheets="@styles/gaming-theme.css"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.esprit.controllers.GestionEvenementController">

    <left>
        <VBox prefWidth="230" spacing="20" styleClass="sidebar">
            <padding>
                <Insets top="28" right="18" bottom="28" left="18"/>
            </padding>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <StackPane styleClass="brand-mark">
                    <Label text="TH" styleClass="brand-mark-text"/>
                </StackPane>
                <VBox spacing="4">
                    <Label text="Team Hub" styleClass="brand-title"/>
                    <Label text="Event operations" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>

            <VBox spacing="8">
                <Button fx:id="btnNavGestionEvenements" maxWidth="Infinity" text="Gestion des evenements" styleClass="nav-button-active"/>
                <Button maxWidth="Infinity" text="Inscription user" onAction="#ouvrirInscriptionUser" styleClass="nav-button"/>
                <Button fx:id="btnNavAdminInscriptions" maxWidth="Infinity" text="Admin inscriptions" onAction="#ouvrirAdmin" styleClass="nav-button"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="6" styleClass="glass-panel">
                <padding>
                    <Insets top="14" right="14" bottom="14" left="14"/>
                </padding>
                <Label text="Mode e-sport" styleClass="section-title"/>
                <Label text="Gestion rapide des tournois, matchs et inscriptions." wrapText="true" styleClass="muted-label"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="18" styleClass="content">
            <HBox alignment="CENTER_LEFT" spacing="14">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Gestion des evenements" styleClass="page-title"/>
                    <Label text="Consulte, filtre et pilote les evenements e-sport depuis un seul espace." styleClass="page-subtitle"/>
                </VBox>
                <Button fx:id="btnAjouter" text="Ajouter" onAction="#ouvrirAjouter" styleClass="primary-button"/>
            </HBox>

            <HBox spacing="14">
                <VBox prefWidth="180" spacing="4" styleClass="stat-card">
                    <Label text="Events" styleClass="muted-label"/>
                    <Label text="Live hub" styleClass="stat-number"/>
                </VBox>
                <VBox prefWidth="180" spacing="4" styleClass="stat-card">
                    <Label text="Recherche" styleClass="muted-label"/>
                    <Label text="Titre/Lieu" styleClass="stat-number"/>
                </VBox>
                <VBox prefWidth="180" spacing="4" styleClass="stat-card">
                    <Label text="Actions" styleClass="muted-label"/>
                    <Label text="CRUD" styleClass="stat-number"/>
                </VBox>
            </HBox>

            <VBox spacing="14" styleClass="glass-panel" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="18" right="18" bottom="18" left="18"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Recherche par titre" styleClass="form-label"/>
                        <TextField fx:id="tfRecherchetitre" promptText="Titre de l'evenement"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Recherche par lieu" styleClass="form-label"/>
                        <TextField fx:id="tfRechercheLieu" promptText="Lieu"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text=" " styleClass="form-label"/>
                        <HBox spacing="10">
                            <Button fx:id="btnRechercher" text="Rechercher" onAction="#rechercher" styleClass="primary-button"/>
                            <Button text="Reinitialiser" onAction="#reinitialiser" styleClass="secondary-button"/>
                        </HBox>
                    </VBox>
                </HBox>

                <TableView fx:id="tableEvenements" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTitre" text="Titre" prefWidth="230"/>
                        <TableColumn fx:id="colType" text="Type" prefWidth="105"/>
                        <TableColumn fx:id="colLieu" text="Lieu" prefWidth="145"/>
                        <TableColumn fx:id="colDateDebut" text="Date debut" prefWidth="125"/>
                        <TableColumn fx:id="colDateFin" text="Date fin" prefWidth="125"/>
                        <TableColumn fx:id="colActions" text="Actions" prefWidth="280"/>
                    </columns>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button text="Interface user" onAction="#ouvrirInscriptionUser" styleClass="primary-button"/>
                    <Button fx:id="btnAdminInscriptionsFooter" text="Admin inscriptions" onAction="#ouvrirAdmin" styleClass="secondary-button"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
