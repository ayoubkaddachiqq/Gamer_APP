<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<BorderPane fx:id="rootPane"
            prefHeight="800.0"
            prefWidth="1200.0"
            styleClass="app-shell"
            stylesheets="@styles/gaming-theme.css"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.esprit.controllers.DetailsEvenementController">

    <left>
        <VBox prefWidth="230" spacing="20" styleClass="sidebar">
            <padding>
                <Insets top="28" right="18" bottom="28" left="18"/>
            </padding>
            <VBox spacing="4">
                <Label text="Gamer App" styleClass="brand-title"/>
                <Label text="Event details" styleClass="brand-subtitle"/>
            </VBox>
            <VBox spacing="8">
                <Button maxWidth="Infinity" text="Retour evenements" onAction="#retour" styleClass="nav-button"/>
                <Button maxWidth="Infinity" text="Details" styleClass="nav-button-active"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="18" styleClass="content">
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label fx:id="lbTitre" text="Details de l'evenement" styleClass="page-title"/>
                    <HBox spacing="10">
                        <Label fx:id="lbType" styleClass="status-pill"/>
                        <Label fx:id="lbStatut" styleClass="status-pill"/>
                    </HBox>
                </VBox>
                <Button text="Retour" onAction="#retour" styleClass="secondary-button"/>
            </HBox>

            <HBox spacing="18" VBox.vgrow="ALWAYS">
                <VBox spacing="16" minWidth="360" prefWidth="470" styleClass="glass-panel">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <ImageView fx:id="imageEvenement" fitWidth="420" fitHeight="235" preserveRatio="true"
                               style="-fx-background-color: #0f1729;"/>

                    <VBox spacing="8">
                        <Label text="Description" styleClass="section-title"/>
                        <Label fx:id="lbDescription" wrapText="true" styleClass="label"/>
                    </VBox>

                    <GridPane hgap="14" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="38"/>
                            <ColumnConstraints percentWidth="62"/>
                        </columnConstraints>

                        <Label text="Lieu" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="lbLieu" styleClass="label" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Date debut" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="lbDateDebut" styleClass="label" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Date fin" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label fx:id="lbDateFin" styleClass="label" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Participants max" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <Label fx:id="lbNbMax" styleClass="label" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    </GridPane>

                    <VBox spacing="8">
                        <Label text="Meteo" styleClass="section-title"/>
                        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="weather-card">
                            <Label fx:id="lbWeatherIcon" text="--" styleClass="weather-icon"/>
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label fx:id="lbWeatherTitle" text="Meteo non verifiee" styleClass="weather-title"/>
                                <Label fx:id="lbWeatherDetails" text="Choisir lieu et date debut" wrapText="true" styleClass="weather-details"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>

                <VBox spacing="12" prefWidth="660" maxWidth="760" HBox.hgrow="ALWAYS" styleClass="glass-panel">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    <Label text="Localisation sur la carte" styleClass="section-title"/>
                    <WebView fx:id="mapView" prefHeight="560" maxHeight="580"
                             style="-fx-background-color: #0f1729; -fx-border-color: rgba(168, 85, 247, 0.28);"
                             VBox.vgrow="ALWAYS"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
