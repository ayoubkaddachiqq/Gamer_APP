<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<BorderPane fx:id="rootPane"
            prefHeight="800.0"
            prefWidth="1200.0"
            styleClass="app-shell"
            stylesheets="@styles/gaming-theme.css"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.esprit.controllers.AjouterEvenementController">

    <left>
        <VBox prefWidth="230" spacing="20" styleClass="sidebar">
            <padding>
                <Insets top="28" right="18" bottom="28" left="18"/>
            </padding>
            <VBox spacing="4">
                <Label text="Gamer App" styleClass="brand-title"/>
                <Label text="Event editor" styleClass="brand-subtitle"/>
            </VBox>
            <VBox spacing="8">
                <Button maxWidth="Infinity" text="Evenements" onAction="#retour" styleClass="nav-button"/>
                <Button maxWidth="Infinity" text="Edition" styleClass="nav-button-active"/>
                <Button maxWidth="Infinity" text="Carte" onAction="#ouvrirMaps" styleClass="nav-button"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="18" styleClass="content">
            <HBox alignment="CENTER_LEFT" spacing="14">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Ajouter / Modifier un evenement" styleClass="page-title"/>
                    <Label text="Configure les informations, le lieu, la capacite et l'affiche." styleClass="page-subtitle"/>
                </VBox>
                <Button text="Retour" onAction="#retour" styleClass="secondary-button"/>
            </HBox>

            <HBox spacing="14" alignment="TOP_LEFT" fillHeight="true" VBox.vgrow="ALWAYS">
                <GridPane hgap="12" vgap="9" minWidth="0" prefWidth="430" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="glass-panel">
                    <padding>
                        <Insets top="14" right="14" bottom="14" left="14"/>
                    </padding>
                    <columnConstraints>
                        <ColumnConstraints percentWidth="32"/>
                        <ColumnConstraints percentWidth="68"/>
                    </columnConstraints>

                    <Label text="Titre" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="tfTitre" promptText="Nom de l'evenement" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Description" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <VBox spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="1">
                        <TextArea fx:id="taDescription" prefRowCount="2" wrapText="true"/>
                        <Button text="Corriger l'orthographe" onAction="#corrigerDescription" styleClass="secondary-button"/>
                    </VBox>

                    <Label text="Type" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cbType" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Date debut" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <HBox spacing="8" GridPane.rowIndex="3" GridPane.columnIndex="1">
                        <DatePicker fx:id="dpDateDebut" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="tfHeureDebut" prefWidth="92" promptText="18:00"/>
                    </HBox>

                    <Label text="Date fin" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <HBox spacing="8" GridPane.rowIndex="4" GridPane.columnIndex="1">
                        <DatePicker fx:id="dpDateFin" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="tfHeureFin" prefWidth="92" promptText="22:00"/>
                    </HBox>

                    <Label text="Lieu" styleClass="form-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <TextField fx:id="tfLieu" promptText="Ex: Tunis, Lac 2" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <Label text="Meteo" styleClass="form-label" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="weather-card" GridPane.rowIndex="6" GridPane.columnIndex="1">
                        <Label fx:id="lbWeatherIcon" text="--" styleClass="weather-icon"/>
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label fx:id="lbWeatherTitle" text="Meteo non verifiee" styleClass="weather-title"/>
                            <Label fx:id="lbWeatherDetails" text="Choisir lieu et date debut" wrapText="true" styleClass="weather-details"/>
                        </VBox>
                        <Button text="Verifier" onAction="#verifierMeteo" styleClass="secondary-button"/>
                    </HBox>

                    <Label text="Participants max" styleClass="form-label" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                    <TextField fx:id="tfNbMax" promptText="128" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                    <Label text="Statut" styleClass="form-label" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cbStatut" maxWidth="Infinity" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                    <Label text="Image" styleClass="form-label" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                    <HBox spacing="10" GridPane.rowIndex="9" GridPane.columnIndex="1">
                        <TextField fx:id="tfImage" HBox.hgrow="ALWAYS" promptText="Chemin de l'affiche"/>
                        <Button text="Choisir" onAction="#choisirImage" styleClass="secondary-button"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_RIGHT" GridPane.rowIndex="10" GridPane.columnIndex="1">
                        <Button fx:id="btnSauvegarder" text="Sauvegarder" onAction="#sauvegarder" styleClass="primary-button"/>
                        <Button text="Retour" onAction="#retour" styleClass="danger-button"/>
                    </HBox>
                </GridPane>

                <VBox spacing="10" minWidth="0" prefWidth="430" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="glass-panel">
                    <padding>
                        <Insets top="14" right="14" bottom="14" left="14"/>
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Localisation" styleClass="section-title"/>
                            <Label text="Entre un lieu puis charge la carte." styleClass="page-subtitle"/>
                        </VBox>
                        <Button text="Voir sur Maps" onAction="#ouvrirMaps" styleClass="primary-button"/>
                    </HBox>
                    <WebView fx:id="mapView" prefHeight="440" maxHeight="470"
                             style="-fx-background-color: #0f1729; -fx-border-color: rgba(168, 85, 247, 0.28);"
                             VBox.vgrow="ALWAYS"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
