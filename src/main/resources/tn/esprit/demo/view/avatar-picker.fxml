<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Avatar Picker – TeamHub Desktop Application
    Controller : tn.esprit.demo.controller.AvatarPickerController
    Opened as  : modal popup (Stage)
-->
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.demo.controller.AvatarPickerController"
      prefWidth="540" minWidth="540" maxWidth="540"
      spacing="0"
      style="-fx-background-color: #080C1A;
             -fx-border-color: #1e2d45; -fx-border-width: 1;">

    <!-- Header -->
    <VBox alignment="CENTER" spacing="4"
          style="-fx-padding: 20 30 14 30;
                 -fx-border-color: #1a2d42; -fx-border-width: 0 0 1 0;">
        <Label text="CHOOSE YOUR AVATAR"
               style="-fx-text-fill: #00E5FF; -fx-font-size: 16px; -fx-font-weight: bold;"/>
        <Label text="Pick a preset or upload your own image"
               style="-fx-text-fill: #5a6478; -fx-font-size: 11px;"/>
    </VBox>

    <!-- Preset grid -->
    <VBox spacing="10" style="-fx-padding: 18 30 6 30;">
        <Label text="PRESET AVATARS"
               style="-fx-text-fill: #7a8899; -fx-font-size: 10px; -fx-font-weight: bold;"/>
        <FlowPane fx:id="avatarGrid" hgap="12" vgap="12" prefWrapLength="480"/>
    </VBox>

    <!-- Admin folder avatars (hidden until admin sets a folder) -->
    <VBox fx:id="adminSection" spacing="10"
          visible="false" managed="false"
          style="-fx-padding: 6 30 6 30;">
        <Region prefHeight="1" prefWidth="480"
                style="-fx-background-color: #1a2d42;"/>
        <Label text="TEAM AVATARS"
               style="-fx-text-fill: #7a8899; -fx-font-size: 10px; -fx-font-weight: bold;"/>
        <FlowPane fx:id="adminGrid" hgap="12" vgap="12" prefWrapLength="480"/>
    </VBox>

    <!-- Divider -->
    <Region prefHeight="1" prefWidth="540"
            style="-fx-background-color: #1a2d42; -fx-margin: 6 0;"/>

    <!-- Upload section -->
    <VBox spacing="8" style="-fx-padding: 14 30 10 30;">
        <Label text="UPLOAD YOUR OWN"
               style="-fx-text-fill: #7a8899; -fx-font-size: 10px; -fx-font-weight: bold;"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="uploadBtn" text="📁  Browse Image…" onAction="#handleUpload"
                    style="-fx-background-color: #12192e;
                           -fx-text-fill: #dde4f0; -fx-font-size: 12px;
                           -fx-border-color: #243044; -fx-border-radius: 7;
                           -fx-background-radius: 7; -fx-padding: 8 16; -fx-cursor: hand;"/>
            <Label fx:id="uploadPathLabel" text="No file selected"
                   style="-fx-text-fill: #3d4a5c; -fx-font-size: 11px;"
                   maxWidth="260" wrapText="false"/>
        </HBox>
        <!-- Preview of uploaded file -->
        <StackPane fx:id="uploadPreviewPane"
                   prefWidth="64" prefHeight="64" maxWidth="64" maxHeight="64"
                   visible="false" managed="false"
                   style="-fx-background-color: #0a2230;
                          -fx-background-radius: 32;
                          -fx-border-color: #00E5FF;
                          -fx-border-radius: 32; -fx-border-width: 2;">
            <ImageView fx:id="uploadPreviewImage"
                       fitWidth="60" fitHeight="60" preserveRatio="false"/>
        </StackPane>
    </VBox>

    <!-- Footer buttons -->
    <Region prefHeight="1" prefWidth="540"
            style="-fx-background-color: #1a2d42;"/>
    <HBox alignment="CENTER_RIGHT" spacing="10"
          style="-fx-padding: 14 30;">
        <Button text="Cancel" onAction="#handleCancel"
                style="-fx-background-color: transparent; -fx-text-fill: #7a8899;
                       -fx-font-size: 12px; -fx-cursor: hand; -fx-underline: true;
                       -fx-border-color: transparent;"/>
        <Button text="Apply" onAction="#handleApply"
                style="-fx-background-color: #00E5FF; -fx-text-fill: #050814;
                       -fx-font-size: 13px; -fx-font-weight: bold;
                       -fx-background-radius: 7; -fx-cursor: hand; -fx-padding: 9 20;"/>
    </HBox>
</VBox>
