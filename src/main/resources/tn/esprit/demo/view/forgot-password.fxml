<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Forgot Password View – TeamHub Desktop Application
    Controller : tn.esprit.demo.controller.ForgotPasswordController
    FXML path  : /tn/esprit/demo/view/forgot-password.fxml
    Window     : 1000 x 700
-->
<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.demo.controller.ForgotPasswordController"
           prefWidth="1000" minWidth="1000" maxWidth="1000"
           prefHeight="700" minHeight="700" maxHeight="700">

    <ImageView fitWidth="1000" fitHeight="700" preserveRatio="false" smooth="true">
        <image><Image url="@bg.jpg" preserveRatio="false"/></image>
    </ImageView>

    <Region prefWidth="1000" prefHeight="700"
            style="-fx-background-color:
                       linear-gradient(to right,
                           rgba(5,8,20,0.10) 0%,
                           rgba(5,8,20,0.50) 40%,
                           rgba(5,8,20,0.93) 100%);"/>

    <VBox StackPane.alignment="CENTER_RIGHT"
          alignment="CENTER"
          spacing="0"
          prefWidth="380" minWidth="380" maxWidth="380"
          style="-fx-background-color: rgba(8,12,26,0.92);
                 -fx-background-radius: 14;
                 -fx-border-color: #1e2d45;
                 -fx-border-radius: 14;
                 -fx-border-width: 1;">
        <StackPane.margin><Insets right="50"/></StackPane.margin>

        <VBox alignment="CENTER" spacing="7"
              style="-fx-padding: 32 36 18 36;">
            <StackPane prefWidth="52" prefHeight="52" maxWidth="52" maxHeight="52"
                       style="-fx-background-color: #00E5FF; -fx-background-radius: 10;">
                <Label text="✦" style="-fx-text-fill: #050814; -fx-font-size: 22px; -fx-font-weight: bold;"/>
            </StackPane>
            <Label text="RESET ACCESS"
                   style="-fx-text-fill: #00E5FF; -fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Label text="Secure recovery protocol"
                   style="-fx-text-fill: #5a6478; -fx-font-size: 10px;"/>
        </VBox>

        <Region prefHeight="1" prefWidth="380" style="-fx-background-color: #1a2d42;"/>

        <VBox spacing="10" style="-fx-padding: 24 36 24 36;">
            <Label text="Forgot Password"
                   style="-fx-text-fill: #eef2f7; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label text="Enter your email to receive a code."
                   style="-fx-text-fill: #5a6478; -fx-font-size: 12px;">
                <VBox.margin><Insets bottom="8"/></VBox.margin>
            </Label>

            <Label text="EMAIL ADDRESS"
                   style="-fx-text-fill: #7a8899; -fx-font-size: 10px; -fx-font-weight: bold;"/>
            <TextField fx:id="emailField"
                       promptText="name@organization.com"
                       prefWidth="308" maxWidth="308"
                       style="-fx-background-color: #12192e;
                              -fx-text-fill: #dde4f0;
                              -fx-prompt-text-fill: #3d4a5c;
                              -fx-border-color: #243044;
                              -fx-border-radius: 7; -fx-background-radius: 7;
                              -fx-padding: 12 14; -fx-font-size: 13px;"/>

            <Button text="Send Code" onAction="#handleSendCode"
                    prefWidth="308" maxWidth="308"
                    style="-fx-background-color: #00E5FF;
                           -fx-text-fill: #050814;
                           -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-background-radius: 7; -fx-cursor: hand;
                           -fx-padding: 12 0;">
                <VBox.margin><Insets top="8"/></VBox.margin>
            </Button>

            <Region prefHeight="1" prefWidth="308" style="-fx-background-color: #1a2d42;">
                <VBox.margin><Insets top="6" bottom="6"/></VBox.margin>
            </Region>

            <Label text="VERIFICATION CODE"
                   style="-fx-text-fill: #7a8899; -fx-font-size: 10px; -fx-font-weight: bold;"/>
            <TextField fx:id="codeField"
                       promptText="6-digit code"
                       prefWidth="308" maxWidth="308"
                       style="-fx-background-color: #12192e;
                              -fx-text-fill: #dde4f0;
                              -fx-prompt-text-fill: #3d4a5c;
                              -fx-border-color: #243044;
                              -fx-border-radius: 7; -fx-background-radius: 7;
                              -fx-padding: 12 14; -fx-font-size: 13px;"/>

            <Label text="NEW PASSWORD"
                   style="-fx-text-fill: #7a8899; -fx-font-size: 10px; -fx-font-weight: bold;">
                <VBox.margin><Insets top="6"/></VBox.margin>
            </Label>
            <PasswordField fx:id="newPasswordField"
                           promptText="••••••••"
                           prefWidth="308" maxWidth="308"
                           style="-fx-background-color: #12192e;
                                  -fx-text-fill: #dde4f0;
                                  -fx-prompt-text-fill: #3d4a5c;
                                  -fx-border-color: #243044;
                                  -fx-border-radius: 7; -fx-background-radius: 7;
                                  -fx-padding: 12 14; -fx-font-size: 13px;"/>

            <Button text="Reset Password" onAction="#handleResetPassword"
                    prefWidth="308" maxWidth="308"
                    style="-fx-background-color: #00E5FF;
                           -fx-text-fill: #050814;
                           -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-background-radius: 7; -fx-cursor: hand;
                           -fx-padding: 12 0;">
                <VBox.margin><Insets top="8"/></VBox.margin>
            </Button>

            <Label fx:id="statusLabel"
                   text=""
                   wrapText="true"
                   style="-fx-text-fill: #5a6478; -fx-font-size: 11px;">
                <VBox.margin><Insets top="6"/></VBox.margin>
            </Label>

            <HBox alignment="CENTER" style="-fx-padding: 8 0 0 0;">
                <Button text="Back to Sign In" onAction="#goToLogin"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #00E5FF; -fx-font-size: 12px;
                               -fx-cursor: hand; -fx-underline: true;
                               -fx-padding: 0; -fx-border-color: transparent;"/>
            </HBox>
        </VBox>

        <Region prefHeight="1" prefWidth="380" style="-fx-background-color: #1a2d42;"/>

        <HBox alignment="CENTER" spacing="10" style="-fx-padding: 12 36;">
            <Label text="●" style="-fx-text-fill: #22c55e; -fx-font-size: 9px;"/>
            <Label text="Systems Online" style="-fx-text-fill: #3d4a5c; -fx-font-size: 9px;"/>
            <Label text="|" style="-fx-text-fill: #243044; -fx-font-size: 9px;"/>
            <Label text="Version 2.4.0-Pro" style="-fx-text-fill: #3d4a5c; -fx-font-size: 9px;"/>
        </HBox>
    </VBox>

</StackPane>
