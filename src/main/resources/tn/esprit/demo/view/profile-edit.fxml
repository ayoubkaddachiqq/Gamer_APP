<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Profile Edit View – TeamHub Desktop Application
    Controller : tn.esprit.demo.controller.ProfileEditController
    Window     : 1000 x 860
-->
<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.demo.controller.ProfileEditController"
           prefWidth="1000" minWidth="1000" maxWidth="1000"
           prefHeight="860" minHeight="860" maxHeight="860">

    <!-- Background -->
    <ImageView fitWidth="1000" fitHeight="860" preserveRatio="false" smooth="true">
        <image><Image url="@bg.jpg" preserveRatio="false"/></image>
    </ImageView>

    <Region prefWidth="1000" prefHeight="860"
            style="-fx-background-color:
                       linear-gradient(to right,
                           rgba(5,8,20,0.10) 0%,
                           rgba(5,8,20,0.50) 40%,
                           rgba(5,8,20,0.93) 100%);"/>

    <!-- Scrollable wrapper so the taller card doesn't clip -->
    <ScrollPane fitToWidth="true" fitToHeight="false"
                style="-fx-background: transparent; -fx-background-color: transparent;
                       -fx-border-color: transparent; -fx-padding: 20 0;">

        <!-- Card -->
        <VBox alignment="CENTER" spacing="0"
              prefWidth="760" maxWidth="760"
              style="-fx-background-color: rgba(8,12,26,0.93);
                     -fx-background-radius: 14;
                     -fx-border-color: #1e2d45;
                     -fx-border-radius: 14;
                     -fx-border-width: 1;"
              VBox.vgrow="NEVER">
            <VBox.margin><Insets left="120" right="120"/></VBox.margin>

            <!-- ── Header ── -->
            <VBox alignment="CENTER" spacing="6" style="-fx-padding: 24 40 16 40;">
                <Label text="EDIT PROFILE"
                       style="-fx-text-fill: #00E5FF; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label text="Update your public identity"
                       style="-fx-text-fill: #5a6478; -fx-font-size: 11px;"/>
            </VBox>

            <Region prefHeight="1" prefWidth="760" style="-fx-background-color: #1a2d42;"/>

            <!-- ── Form body ── -->
            <VBox spacing="10" style="-fx-padding: 20 40 24 40;">

                <!-- Row 1: Display Name + Username -->
                <HBox spacing="16">
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="DISPLAY NAME" style="-fx-text-fill: #7a8899; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                        <TextField fx:id="displayNameField" promptText="Display name"
                                   style="-fx-background-color: #12192e; -fx-text-fill: #dde4f0;
                                          -fx-prompt-text-fill: #3d4a5c; -fx-border-color: #243044;
                                          -fx-border-radius: 7; -fx-background-radius: 7;
                                          -fx-padding: 10 12; -fx-font-size: 13px;"/>
                    </VBox>
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="USERNAME" style="-fx-text-fill: #7a8899; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                        <TextField fx:id="usernameField" promptText="Username"
                                   style="-fx-background-color: #12192e; -fx-text-fill: #dde4f0;
                                          -fx-prompt-text-fill: #3d4a5c; -fx-border-color: #243044;
                                          -fx-border-radius: 7; -fx-background-radius: 7;
                                          -fx-padding: 10 12; -fx-font-size: 13px;"/>
                    </VBox>
                </HBox>

                <!-- Row 2: Email + Avatar -->
                <HBox spacing="16">
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="EMAIL" style="-fx-text-fill: #7a8899; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                        <TextField fx:id="emailField" promptText="Email"
                                   style="-fx-background-color: #12192e; -fx-text-fill: #dde4f0;
                                          -fx-prompt-text-fill: #3d4a5c; -fx-border-color: #243044;
                                          -fx-border-radius: 7; -fx-background-radius: 7;
                                          -fx-padding: 10 12; -fx-font-size: 13px;"/>
                    </VBox>

                    <!-- Avatar preview + picker -->
                    <VBox spacing="8" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                        <Label text="PROFILE PICTURE" style="-fx-text-fill: #7a8899; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <StackPane fx:id="avatarPreviewPane"
                                       prefWidth="64" prefHeight="64" maxWidth="64" maxHeight="64"
                                       style="-fx-background-color: #0a2230; -fx-background-radius: 32;
                                              -fx-border-color: #00E5FF; -fx-border-radius: 32; -fx-border-width: 2;">
                                <Label fx:id="avatarPreviewLabel" text="?"
                                       style="-fx-text-fill: #00E5FF; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                                <ImageView fx:id="avatarPreviewImage" fitWidth="64" fitHeight="64"
                                           preserveRatio="false" visible="false" managed="false"/>
                            </StackPane>
                            <Button text="Change Avatar" onAction="#handleChangeAvatar"
                                    style="-fx-background-color: transparent; -fx-text-fill: #00E5FF;
                                           -fx-font-size: 12px; -fx-border-color: #00E5FF;
                                           -fx-border-radius: 7; -fx-background-radius: 7;
                                           -fx-padding: 8 14; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- ──────────────────────── AI AVATAR SECTION ──────────────────────── -->
                <VBox spacing="8"
                      style="-fx-background-color: rgba(0,229,255,0.04);
                             -fx-border-color: #1a3a50; -fx-border-radius: 9;
                             -fx-background-radius: 9; -fx-border-width: 1; -fx-padding: 14 16;">
                    <VBox spacing="3">
                        <Label text="✨  AI AVATAR GENERATOR"
                               style="-fx-text-fill: #a78bfa; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                        <Label text="Upload a photo — we'll cartoonify it into your gamer avatar"
                               style="-fx-text-fill: #3d4a5c; -fx-font-size: 10px;"/>
                    </VBox>
                    <Button fx:id="generateAiAvatarBtn" text="✨  Generate AI Avatar"
                            onAction="#handleGenerateAiAvatar"
                            style="-fx-background-color: linear-gradient(to right, #7c3aed, #4f46e5);
                                   -fx-text-fill: #fff; -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 11 20;
                                   -fx-effect: dropshadow(gaussian,#7c3aed88,12,0.4,0,2);"/>
                    <Label fx:id="aiStatusLabel" text="" wrapText="true" maxWidth="660"
                           style="-fx-text-fill: #00E5FF; -fx-font-size: 11px;"
                           visible="false" managed="false"/>
                    <Button fx:id="saveAiAvatarBtn" text="💾  Save Avatar"
                            onAction="#handleSaveAiAvatar"
                            style="-fx-background-color: #22c55e; -fx-text-fill: #050814;
                                   -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-background-radius: 7; -fx-cursor: hand; -fx-padding: 10 18;
                                   -fx-effect: dropshadow(gaussian,#22c55e88,10,0.4,0,2);"
                            visible="false" managed="false"/>
                </VBox>

                <!-- ──────────────────────── RIOT / LOL SECTION ──────────────────────── -->
                <VBox spacing="8"
                      style="-fx-background-color: rgba(200,80,0,0.04);
                             -fx-border-color: #3a1e0f; -fx-border-radius: 9;
                             -fx-background-radius: 9; -fx-border-width: 1; -fx-padding: 14 16;">

                    <!-- Header -->
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="⚔  LEAGUE OF LEGENDS ACCOUNT"
                               style="-fx-text-fill: #f59e0b; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                    </HBox>
                    <Label text="Link your Riot ID to display your rank on your profile"
                           style="-fx-text-fill: #3d4a5c; -fx-font-size: 10px;"/>

                    <!-- Inputs -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="riotGameNameField" promptText="Game Name  (e.g. Faker)"
                                   prefWidth="240"
                                   style="-fx-background-color: #12192e; -fx-text-fill: #dde4f0;
                                          -fx-prompt-text-fill: #3d4a5c; -fx-border-color: #3a2e10;
                                          -fx-border-radius: 7; -fx-background-radius: 7;
                                          -fx-padding: 9 12; -fx-font-size: 13px;"/>
                        <Label text="#" style="-fx-text-fill: #f59e0b; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                        <TextField fx:id="riotTagLineField" promptText="Tag  (e.g. EUW)"
                                   prefWidth="120"
                                   style="-fx-background-color: #12192e; -fx-text-fill: #dde4f0;
                                          -fx-prompt-text-fill: #3d4a5c; -fx-border-color: #3a2e10;
                                          -fx-border-radius: 7; -fx-background-radius: 7;
                                          -fx-padding: 9 12; -fx-font-size: 13px;"/>
                        <Button fx:id="linkRiotBtn" text="🔗  Link Account"
                                onAction="#handleLinkRiot"
                                style="-fx-background-color: linear-gradient(to right,#b45309,#d97706);
                                       -fx-text-fill: #050814; -fx-font-size: 12px; -fx-font-weight: bold;
                                       -fx-background-radius: 7; -fx-cursor: hand; -fx-padding: 10 16;
                                       -fx-effect: dropshadow(gaussian,#d9770688,10,0.4,0,2);"/>
                        <Button fx:id="unlinkRiotBtn" text="✖  Unlink"
                                onAction="#handleUnlinkRiot"
                                style="-fx-background-color: transparent; -fx-text-fill: #f87171;
                                       -fx-font-size: 11px; -fx-cursor: hand;
                                       -fx-border-color: #f87171; -fx-border-radius: 6;
                                       -fx-background-radius: 6; -fx-padding: 9 12;"
                                visible="false" managed="false"/>
                    </HBox>

                    <!-- Status label -->
                    <Label fx:id="riotStatusLabel" text="" wrapText="true" maxWidth="660"
                           style="-fx-text-fill: #5a6478; -fx-font-size: 11px;"
                           visible="false" managed="false"/>

                    <!-- Preview box (shown after successful link) -->
                    <VBox fx:id="riotPreviewBox" spacing="8"
                          style="-fx-background-color: rgba(0,0,0,0.25);
                                 -fx-border-color: #3a2e10; -fx-border-radius: 7;
                                 -fx-background-radius: 7; -fx-border-width: 1; -fx-padding: 12 14;"
                          visible="false" managed="false">

                        <!-- Icon + text side by side -->
                        <HBox spacing="14" alignment="CENTER_LEFT">

                            <!-- LoL profile icon -->
                            <StackPane fx:id="lolIconPane"
                                       prefWidth="56" prefHeight="56"
                                       style="-fx-background-color: #0d1220;
                                              -fx-background-radius: 28;
                                              -fx-border-color: #f59e0b;
                                              -fx-border-radius: 28;
                                              -fx-border-width: 2;">
                                <ImageView fx:id="lolIconView"
                                           fitWidth="52" fitHeight="52"
                                           preserveRatio="true" smooth="true"
                                           visible="false"/>
                                <Label fx:id="lolIconPlaceholder" text="⚔"
                                       style="-fx-font-size:22px;-fx-text-fill:#f59e0b;"/>
                            </StackPane>

                            <!-- Rank / stats text -->
                            <VBox spacing="3">
                                <Label fx:id="riotPreviewName" text=""
                                       style="-fx-text-fill: #dde4f0; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                                <Label fx:id="riotPreviewRank" text=""
                                       style="-fx-text-fill: #FFD700; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                                <Label fx:id="riotPreviewStats" text=""
                                       style="-fx-text-fill: #8a96aa; -fx-font-size: 12px;"/>
                            </VBox>
                        </HBox>

                        <!-- Use as avatar button -->
                        <Button fx:id="useLolAvatarBtn"
                                text="🖼  Use LoL Icon as Avatar"
                                onAction="#handleUseLolAvatar"
                                style="-fx-background-color: transparent;
                                       -fx-text-fill: #f59e0b;
                                       -fx-font-size: 11px; -fx-cursor: hand;
                                       -fx-border-color: #f59e0b;
                                       -fx-border-radius: 6; -fx-background-radius: 6;
                                       -fx-padding: 6 12;"
                                visible="false" managed="false"/>
                    </VBox>

                    <!-- Save riot button -->
                    <Button fx:id="saveRiotBtn" text="💾  Save Riot Account"
                            onAction="#handleSaveRiot"
                            style="-fx-background-color: #22c55e; -fx-text-fill: #050814;
                                   -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-background-radius: 7; -fx-cursor: hand; -fx-padding: 10 18;
                                   -fx-effect: dropshadow(gaussian,#22c55e88,10,0.4,0,2);"
                            visible="false" managed="false"/>
                </VBox>

                <!-- Bio -->
                <Label text="BIO" style="-fx-text-fill: #7a8899; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                <TextArea fx:id="bioField" promptText="Tell the community about yourself"
                          prefRowCount="3" wrapText="true"
                          style="-fx-background-color: #12192e; -fx-text-fill: #dde4f0;
                                 -fx-prompt-text-fill: #3d4a5c; -fx-border-color: #243044;
                                 -fx-border-radius: 7; -fx-background-radius: 7;
                                 -fx-padding: 10 12; -fx-font-size: 13px;"/>

                <!-- Status -->
                <Label text="STATUS" style="-fx-text-fill: #7a8899; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                <Label fx:id="statusLabel" text="" style="-fx-text-fill: #5a6478; -fx-font-size: 11px;"/>

                <!-- Action row -->
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button text="Cancel" onAction="#handleCancel"
                            style="-fx-background-color: transparent; -fx-text-fill: #7a8899;
                                   -fx-font-size: 12px; -fx-cursor: hand; -fx-underline: true;"/>
                    <Button text="Save Changes" onAction="#handleSave"
                            style="-fx-background-color: #00E5FF; -fx-text-fill: #050814;
                                   -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-background-radius: 7; -fx-cursor: hand; -fx-padding: 10 16;"/>
                </HBox>
            </VBox>
        </VBox>
    </ScrollPane>

</StackPane>
