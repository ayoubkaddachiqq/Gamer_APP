<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Gamer Profile View – TeamHub Desktop Application
    Controller : tn.esprit.demo.controller.ProfileController
    FXML path  : /tn/esprit/demo/view/profile.fxml
    Window     : 1200 x 750
-->
<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.demo.controller.ProfileController"
           prefWidth="1200" minWidth="1200" maxWidth="1200"
           prefHeight="750" minHeight="750" maxHeight="750">

    <!-- ── Full-coverage background ── -->
    <ImageView fitWidth="1200" fitHeight="750" preserveRatio="false" smooth="true">
        <image><Image url="@bg.jpg" preserveRatio="false"/></image>
    </ImageView>

    <!-- Very dark overlay so UI reads clearly -->
    <Region prefWidth="1200" prefHeight="750"
            style="-fx-background-color: rgba(4,7,18,0.87);"/>

    <!-- ═══════════════════════════════════════════════════
         ROOT LAYOUT  — VBox (top-bar + content-row)
         ═══════════════════════════════════════════════════ -->
    <VBox prefWidth="1200" prefHeight="750" spacing="0">

        <!-- ════════════════════════════════
             TOP NAV BAR
             ════════════════════════════════ -->
        <HBox alignment="CENTER_LEFT" spacing="24"
              style="-fx-background-color: rgba(8,12,26,0.95);
                     -fx-border-color: #1a2d42;
                     -fx-border-width: 0 0 1 0;
                     -fx-padding: 0 32;">
            <prefHeight>58</prefHeight>

            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <StackPane prefWidth="30" prefHeight="30"
                           style="-fx-background-color: #00E5FF; -fx-background-radius: 6;">
                    <Label text="✦" style="-fx-text-fill: #050814; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                </StackPane>
                <Label text="TEAM HUB"
                       style="-fx-text-fill: #00E5FF; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            </HBox>

            <!-- Spacer -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Nav links -->
            <Button text="Dashboard"
                    style="-fx-background-color: transparent; -fx-text-fill: #5a6478;
                           -fx-font-size: 13px; -fx-cursor: hand; -fx-border-color: transparent;"/>
            <Button text="My Profile"
                    style="-fx-background-color: transparent; -fx-text-fill: #00E5FF;
                           -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;
                           -fx-border-color: transparent;
                           -fx-border-width: 0 0 2 0; -fx-padding: 0 0 2 0;"/>
            <Button text="Matches"
                    style="-fx-background-color: transparent; -fx-text-fill: #5a6478;
                           -fx-font-size: 13px; -fx-cursor: hand; -fx-border-color: transparent;"/>
            <Button text="Teams"
                    style="-fx-background-color: transparent; -fx-text-fill: #5a6478;
                           -fx-font-size: 13px; -fx-cursor: hand; -fx-border-color: transparent;"/>

            <Separator orientation="VERTICAL" style="-fx-background-color: #1a2d42;"/>

            <!-- Online indicator -->
            <HBox alignment="CENTER" spacing="6">
                <Label text="●" style="-fx-text-fill: #22c55e; -fx-font-size: 9px;"/>
                <Label text="Online" style="-fx-text-fill: #22c55e; -fx-font-size: 11px;"/>
            </HBox>

            <Button text="⏻  Logout" onAction="#handleLogout"
                    style="-fx-background-color: #1a2d42;
                           -fx-text-fill: #7a8899; -fx-font-size: 12px;
                           -fx-background-radius: 6; -fx-cursor: hand;
                           -fx-padding: 7 14; -fx-border-color: #243044;
                           -fx-border-radius: 6;"/>
        </HBox>

        <!-- ════════════════════════════════
             MAIN CONTENT ROW
             ════════════════════════════════ -->
        <HBox VBox.vgrow="ALWAYS" spacing="0">

            <!-- ──────────────────────────────────
                 LEFT SIDEBAR  (player card)
                 ────────────────────────────────── -->
            <VBox alignment="TOP_CENTER" spacing="0"
                  prefWidth="280" minWidth="280" maxWidth="280"
                  style="-fx-background-color: rgba(8,12,26,0.90);
                         -fx-border-color: #1a2d42;
                         -fx-border-width: 0 1 0 0;
                         -fx-padding: 32 24 24 24;">

                <!-- Avatar circle -->
                <StackPane fx:id="avatarPane"
                           prefWidth="100" prefHeight="100"
                           maxWidth="100" maxHeight="100"
                           style="-fx-background-color: #0a2230;
                                  -fx-background-radius: 50;
                                  -fx-border-color: #00E5FF;
                                  -fx-border-radius: 50;
                                  -fx-border-width: 2.5;
                                  -fx-effect: dropshadow(gaussian,#00E5FF88,18,0.4,0,0);">
                    <!-- Shown when no image is set -->
                    <Label fx:id="avatarLabel"
                           text="PG"
                           style="-fx-text-fill: #00E5FF;
                                  -fx-font-size: 32px;
                                  -fx-font-weight: bold;"/>
                    <!-- Shown when avatar image is set; clipped to circle in controller -->
                    <ImageView fx:id="avatarImageView"
                               fitWidth="100" fitHeight="100"
                               preserveRatio="false"
                               visible="false" managed="false"/>
                </StackPane>
                <VBox.margin><Insets bottom="14"/></VBox.margin>

                <!-- Rank badge (hidden when no LoL account linked) -->
                <StackPane fx:id="sidebarRankPane" maxWidth="120"
                           style="-fx-background-color: rgba(0,229,255,0.12);
                                  -fx-background-radius: 20;
                                  -fx-border-color: #00E5FF;
                                  -fx-border-radius: 20;
                                  -fx-border-width: 1;
                                  -fx-padding: 3 12;"
                           visible="false" managed="false">
                    <Label fx:id="sidebarRankBadge" text=""
                           style="-fx-text-fill: #00E5FF; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                </StackPane>

                <!-- Gamer tag -->
                <Label fx:id="gamertagLabel"
                       text="ProGamer42"
                       style="-fx-text-fill: #eef2f7; -fx-font-size: 20px; -fx-font-weight: bold;">
                    <VBox.margin><Insets top="10" bottom="4"/></VBox.margin>
                </Label>
                <Label fx:id="emailLabel"
                       text="player@teamhub.gg"
                       style="-fx-text-fill: #5a6478; -fx-font-size: 12px;">
                    <VBox.margin><Insets bottom="20"/></VBox.margin>
                </Label>

                <Separator style="-fx-background-color: #1a2d42;">
                    <VBox.margin><Insets bottom="20"/></VBox.margin>
                </Separator>

                <!-- Quick stats — populated from LoL account if linked -->
                <VBox fx:id="quickStatsBox" spacing="14" visible="false" managed="false">

                    <HBox alignment="CENTER_LEFT" spacing="0">
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="RANK" style="-fx-text-fill: #5a6478; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                            <Label fx:id="rankLabel" text=""
                                   style="-fx-text-fill: #eef2f7; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        </VBox>
                        <Label text="🏆" style="-fx-font-size: 18px;"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="0">
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="WIN RATE" style="-fx-text-fill: #5a6478; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                            <Label fx:id="winRateLabel" text=""
                                   style="-fx-text-fill: #22c55e; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        </VBox>
                        <Label text="📈" style="-fx-font-size: 18px;"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="0">
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="GAMES PLAYED" style="-fx-text-fill: #5a6478; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                            <Label fx:id="matchesLabel" text=""
                                   style="-fx-text-fill: #eef2f7; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        </VBox>
                        <Label text="🎮" style="-fx-font-size: 18px;"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="0">
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="SUMMONER LEVEL" style="-fx-text-fill: #5a6478; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                            <Label fx:id="hoursLabel" text=""
                                   style="-fx-text-fill: #eef2f7; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        </VBox>
                        <Label text="⭐" style="-fx-font-size: 18px;"/>
                    </HBox>

                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <!-- Edit profile button -->
                <Button text="✎  Edit Profile" onAction="#handleEditProfile"
                        prefWidth="232"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #00E5FF; -fx-font-size: 13px;
                               -fx-font-weight: bold; -fx-cursor: hand;
                               -fx-background-radius: 7;
                               -fx-border-color: #00E5FF;
                               -fx-border-radius: 7; -fx-border-width: 1;
                               -fx-padding: 10 0;"/>

                <!-- Face ID enrollment button -->
                <Button fx:id="enrollFaceButton"
                        text="📷  Enroll Face ID"
                        onAction="#handleEnrollFace"
                        prefWidth="232"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #a78bfa; -fx-font-size: 12px;
                               -fx-font-weight: bold; -fx-cursor: hand;
                               -fx-background-radius: 7;
                               -fx-border-color: #7c3aed;
                               -fx-border-radius: 7; -fx-border-width: 1;
                               -fx-padding: 9 0;">
                    <VBox.margin><Insets top="8"/></VBox.margin>
                </Button>

            </VBox>

            <!-- ──────────────────────────────────
                 RIGHT MAIN PANEL (scrollable)
                 ────────────────────────────────── -->
            <ScrollPane HBox.hgrow="ALWAYS" fitToWidth="true"
                        style="-fx-background: transparent; -fx-background-color: transparent;
                               -fx-border-color: transparent;">
            <VBox spacing="20"
                  style="-fx-padding: 28 32 28 32;">

                <!-- ── Bio / About ── -->
                <VBox spacing="8"
                      style="-fx-background-color: rgba(12,18,34,0.85);
                             -fx-background-radius: 10;
                             -fx-border-color: #1a2d42;
                             -fx-border-radius: 10;
                             -fx-border-width: 1;
                             -fx-padding: 18 22;">
                    <Label text="ABOUT"
                           style="-fx-text-fill: #00E5FF; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                    <Label fx:id="bioLabel"
                           text=""
                           wrapText="true"
                           style="-fx-text-fill: #8a96aa; -fx-font-size: 13px; -fx-line-spacing: 3;"/>
                    <Label fx:id="bioPlaceholder"
                           text="No bio yet — add one from Edit Profile."
                           style="-fx-text-fill: #3d4a5c; -fx-font-size: 12px; -fx-font-style: italic;"/>
                </VBox>

                <!-- ── LoL Quick Stats grid (shown only when account linked) ── -->
                <HBox fx:id="statsGrid" spacing="14" visible="false" managed="false">

                    <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: rgba(12,18,34,0.85); -fx-background-radius: 10;
                                 -fx-border-color: #1a2d42; -fx-border-radius: 10; -fx-border-width: 1; -fx-padding: 18 10;">
                        <Label fx:id="stat1Caption" text="WIN RATE" style="-fx-text-fill: #5a6478; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                        <Label fx:id="kdLabel" text=""
                               style="-fx-text-fill: #22c55e; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                        <Label fx:id="stat1Sub" text="Ranked Solo" style="-fx-text-fill: #3d4a5c; -fx-font-size: 10px;"/>
                    </VBox>

                    <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: rgba(12,18,34,0.85); -fx-background-radius: 10;
                                 -fx-border-color: #1a2d42; -fx-border-radius: 10; -fx-border-width: 1; -fx-padding: 18 10;">
                        <Label fx:id="stat2Caption" text="GAMES" style="-fx-text-fill: #5a6478; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                        <Label fx:id="hsLabel" text=""
                               style="-fx-text-fill: #00E5FF; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                        <Label fx:id="stat2Sub" text="Total Played" style="-fx-text-fill: #3d4a5c; -fx-font-size: 10px;"/>
                    </VBox>

                    <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: rgba(12,18,34,0.85); -fx-background-radius: 10;
                                 -fx-border-color: #1a2d42; -fx-border-radius: 10; -fx-border-width: 1; -fx-padding: 18 10;">
                        <Label fx:id="stat3Caption" text="RANK" style="-fx-text-fill: #5a6478; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                        <Label fx:id="mvpLabel" text=""
                               style="-fx-text-fill: #f59e0b; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                        <Label fx:id="stat3Sub" text="Solo Queue" style="-fx-text-fill: #3d4a5c; -fx-font-size: 10px;"/>
                    </VBox>

                    <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: rgba(12,18,34,0.85); -fx-background-radius: 10;
                                 -fx-border-color: #1a2d42; -fx-border-radius: 10; -fx-border-width: 1; -fx-padding: 18 10;">
                        <Label fx:id="stat4Caption" text="LP" style="-fx-text-fill: #5a6478; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                        <Label fx:id="streakLabel" text=""
                               style="-fx-text-fill: #a78bfa; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                        <Label fx:id="stat4Sub" text="League Points" style="-fx-text-fill: #3d4a5c; -fx-font-size: 10px;"/>
                    </VBox>

                </HBox>

                <!-- ── Recent Matches ── -->
                <VBox spacing="0"
                      style="-fx-background-color: rgba(12,18,34,0.85);
                             -fx-background-radius: 10;
                             -fx-border-color: #1a2d42;
                             -fx-border-radius: 10;
                             -fx-border-width: 1;">

                    <!-- Section header -->
                    <HBox alignment="CENTER_LEFT" spacing="10"
                          style="-fx-padding: 14 22 10 22;
                                 -fx-border-color: #1a2d42;
                                 -fx-border-width: 0 0 1 0;">
                        <Label text="RECENT MATCHES"
                               style="-fx-text-fill: #00E5FF; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="View All"
                                style="-fx-background-color: transparent; -fx-text-fill: #5a6478;
                                       -fx-font-size: 10px; -fx-cursor: hand; -fx-border-color: transparent;"/>
                    </HBox>

                    <!-- Match rows — populated dynamically from Riot API -->
                    <VBox spacing="0" fx:id="matchList">
                        <Label fx:id="matchLoadingLabel"
                               text="⏳  Loading match history…"
                               style="-fx-text-fill: #5a6478; -fx-font-size: 12px; -fx-padding: 14 22;"/>
                    </VBox>
                </VBox>

                <!-- ── Achievements ── -->
                <HBox spacing="12">
                    <Label text="ACHIEVEMENTS"
                           style="-fx-text-fill: #7a8899; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                </HBox>
                <HBox spacing="12">

                    <!-- Badge 1 -->
                    <VBox alignment="CENTER" spacing="5" prefWidth="105"
                          style="-fx-background-color: rgba(12,18,34,0.85);
                                 -fx-background-radius: 9;
                                 -fx-border-color: #1a2d42;
                                 -fx-border-radius: 9;
                                 -fx-border-width: 1;
                                 -fx-padding: 12 8;">
                        <Label text="🏅" style="-fx-font-size: 26px;"/>
                        <Label text="Top Fragger" style="-fx-text-fill: #dde4f0; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label text="50 matches" style="-fx-text-fill: #3d4a5c; -fx-font-size: 9px;"/>
                    </VBox>

                    <!-- Badge 2 -->
                    <VBox alignment="CENTER" spacing="5" prefWidth="105"
                          style="-fx-background-color: rgba(12,18,34,0.85);
                                 -fx-background-radius: 9;
                                 -fx-border-color: #1a2d42;
                                 -fx-border-radius: 9;
                                 -fx-border-width: 1;
                                 -fx-padding: 12 8;">
                        <Label text="🔥" style="-fx-font-size: 26px;"/>
                        <Label text="On Fire" style="-fx-text-fill: #dde4f0; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label text="10 win streak" style="-fx-text-fill: #3d4a5c; -fx-font-size: 9px;"/>
                    </VBox>

                    <!-- Badge 3 -->
                    <VBox alignment="CENTER" spacing="5" prefWidth="105"
                          style="-fx-background-color: rgba(12,18,34,0.85);
                                 -fx-background-radius: 9;
                                 -fx-border-color: #f59e0b;
                                 -fx-border-radius: 9;
                                 -fx-border-width: 1;
                                 -fx-padding: 12 8;">
                        <Label text="⭐" style="-fx-font-size: 26px;"/>
                        <Label text="Diamond" style="-fx-text-fill: #f59e0b; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label text="Rank achieved" style="-fx-text-fill: #3d4a5c; -fx-font-size: 9px;"/>
                    </VBox>

                    <!-- Badge 4 -->
                    <VBox alignment="CENTER" spacing="5" prefWidth="105"
                          style="-fx-background-color: rgba(12,18,34,0.85);
                                 -fx-background-radius: 9;
                                 -fx-border-color: #1a2d42;
                                 -fx-border-radius: 9;
                                 -fx-border-width: 1;
                                 -fx-padding: 12 8;">
                        <Label text="🎯" style="-fx-font-size: 26px;"/>
                        <Label text="Sharpshooter" style="-fx-text-fill: #dde4f0; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label text="50% headshots" style="-fx-text-fill: #3d4a5c; -fx-font-size: 9px;"/>
                    </VBox>

                    <!-- Badge 5 -->
                    <VBox alignment="CENTER" spacing="5" prefWidth="105"
                          style="-fx-background-color: rgba(12,18,34,0.85);
                                 -fx-background-radius: 9;
                                 -fx-border-color: #1a2d42;
                                 -fx-border-radius: 9;
                                 -fx-border-width: 1;
                                 -fx-padding: 12 8;">
                        <Label text="🛡" style="-fx-font-size: 26px;"/>
                        <Label text="Captain" style="-fx-text-fill: #dde4f0; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label text="Led a team" style="-fx-text-fill: #3d4a5c; -fx-font-size: 9px;"/>
                    </VBox>

                </HBox>

                <!-- ── League of Legends Stats Card ── -->
                <VBox fx:id="lolCard" spacing="0"
                      style="-fx-background-color: rgba(12,18,34,0.85);
                             -fx-background-radius: 10;
                             -fx-border-color: #2a1e08;
                             -fx-border-radius: 10;
                             -fx-border-width: 1;">
                    <HBox alignment="CENTER_LEFT" spacing="10"
                          style="-fx-padding: 14 22 10 22; -fx-border-color: #2a1e08; -fx-border-width: 0 0 1 0;">
                        <Label text="⚔  LEAGUE OF LEGENDS"
                               style="-fx-text-fill: #f59e0b; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="refreshRiotBtn" text="↻  Refresh Stats"
                                onAction="#handleRefreshRiot"
                                style="-fx-background-color: transparent; -fx-text-fill: #f59e0b;
                                       -fx-font-size: 10px; -fx-cursor: hand;
                                       -fx-border-color: #f59e0b; -fx-border-radius: 5;
                                       -fx-background-radius: 5; -fx-padding: 5 12;"
                                visible="false" managed="false"/>
                    </HBox>
                    <VBox fx:id="lolNoAccount" alignment="CENTER" spacing="8"
                          style="-fx-padding: 20 22;">
                        <Label text="No League account linked."
                               style="-fx-text-fill: #3d4a5c; -fx-font-size: 13px;"/>
                        <Button text="Link Account" onAction="#handleEditProfile"
                                style="-fx-background-color: transparent; -fx-text-fill: #f59e0b;
                                       -fx-font-size: 12px; -fx-cursor: hand;
                                       -fx-border-color: #f59e0b; -fx-border-radius: 6;
                                       -fx-background-radius: 6; -fx-padding: 7 14;"/>
                    </VBox>
                    <HBox fx:id="lolStats" spacing="0" alignment="CENTER_LEFT"
                          style="-fx-padding: 16 22;" visible="false" managed="false">
                        <VBox alignment="CENTER" spacing="6" prefWidth="130">
                            <StackPane fx:id="tierBadge"
                                       prefWidth="80" prefHeight="80" maxWidth="80" maxHeight="80"
                                       style="-fx-background-color: rgba(255,215,0,0.08);
                                              -fx-background-radius: 40; -fx-border-color: #FFD700;
                                              -fx-border-radius: 40; -fx-border-width: 2;
                                              -fx-effect: dropshadow(gaussian,#FFD70066,14,0.4,0,0);">
                                <Label fx:id="tierEmojiLabel" text="🏅" style="-fx-font-size: 30px;"/>
                            </StackPane>
                            <Label fx:id="lolRankLabel" text=""
                                   style="-fx-text-fill: #FFD700; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox spacing="10" HBox.hgrow="ALWAYS">
                            <Label fx:id="lolRiotIdLabel" text=""
                                   style="-fx-text-fill: #eef2f7; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                            <HBox spacing="24">
                                <VBox spacing="2">
                                    <Label text="LEVEL" style="-fx-text-fill: #5a6478; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                                    <Label fx:id="lolLevelLabel" text="—" style="-fx-text-fill: #dde4f0; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                                </VBox>
                                <VBox spacing="2">
                                    <Label text="LP" style="-fx-text-fill: #5a6478; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                                    <Label fx:id="lolLpLabel" text="—" style="-fx-text-fill: #dde4f0; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                                </VBox>
                                <VBox spacing="2">
                                    <Label text="WINS / LOSSES" style="-fx-text-fill: #5a6478; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                                    <Label fx:id="lolWlLabel" text="—" style="-fx-text-fill: #dde4f0; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                                </VBox>
                                <VBox spacing="2">
                                    <Label text="WIN RATE" style="-fx-text-fill: #5a6478; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                                    <Label fx:id="lolWrLabel" text="—" style="-fx-text-fill: #22c55e; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                                </VBox>
                            </HBox>
                            <Label fx:id="lolStatusLabel" text=""
                                   style="-fx-text-fill: #5a6478; -fx-font-size: 11px;"
                                   visible="false" managed="false"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- ── Game Library (favourites preview) ── -->
                <VBox spacing="10"
                      style="-fx-background-color: rgba(12,18,34,0.85);
                             -fx-background-radius: 10;
                             -fx-border-color: #1a2d42;
                             -fx-border-radius: 10;
                             -fx-border-width: 1;">

                    <HBox alignment="CENTER_LEFT" spacing="10"
                          style="-fx-padding: 14 22 10 22;
                                 -fx-border-color: #1a2d42; -fx-border-width: 0 0 1 0;">
                        <Label text="🎮  GAME LIBRARY"
                               style="-fx-text-fill: #00E5FF; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Manage Games" onAction="#handleManageGames"
                                style="-fx-background-color: transparent; -fx-text-fill: #00E5FF;
                                       -fx-font-size: 11px; -fx-cursor: hand;
                                       -fx-border-color: #00E5FF; -fx-border-radius: 5;
                                       -fx-background-radius: 5; -fx-padding: 5 12;"/>
                    </HBox>

                    <!-- Favourite games row (populated by controller) -->
                    <HBox fx:id="favGamesRow" spacing="12"
                          style="-fx-padding: 12 22 16 22; -fx-alignment: CENTER_LEFT;"/>

                    <!-- Placeholder when no favourites yet -->
                    <Label fx:id="noFavLabel"
                           text="No favorite games yet. Add some from your library."
                           style="-fx-text-fill: #3d4a5c; -fx-font-size: 12px;
                                  -fx-padding: 0 22 16 22;"
                           visible="false" managed="false"/>

                </VBox>

            </VBox>
            </ScrollPane>
        </HBox>
    </VBox>

</StackPane>
