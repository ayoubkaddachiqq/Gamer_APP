<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane"
            prefHeight="800.0"
            prefWidth="1200.0"
            styleClass="app-shell"
            stylesheets="@styles/gaming-theme.css"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.esprit.controllers.AdminInscriptionController">

    <left>
        <VBox prefWidth="230" spacing="20" styleClass="sidebar">
            <padding>
                <Insets top="28" right="18" bottom="28" left="18"/>
            </padding>
            <VBox spacing="4">
                <Label text="Gamer App" styleClass="brand-title"/>
                <Label text="Admin registrations" styleClass="brand-subtitle"/>
            </VBox>
            <VBox spacing="8">
                <Button maxWidth="Infinity" text="Evenements" onAction="#retour" styleClass="nav-button"/>
                <Button maxWidth="Infinity" text="Admin inscriptions" styleClass="nav-button-active"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="18" styleClass="content">
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Administration des inscriptions" styleClass="page-title"/>
                    <Label text="Toutes les inscriptions des evenements" styleClass="page-subtitle"/>
                </VBox>
                <Button text="Retour" onAction="#retour" styleClass="secondary-button"/>
            </HBox>

            <VBox spacing="16" styleClass="glass-panel" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <TableView fx:id="tableInscriptions" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                        <TableColumn fx:id="colEvenementId" text="Evenement ID" prefWidth="160"/>
                        <TableColumn fx:id="colUtilisateurId" text="Utilisateur ID" prefWidth="180"/>
                        <TableColumn fx:id="colDateInscription" text="Date inscription" prefWidth="240"/>
                        <TableColumn fx:id="colStatut" text="Statut" prefWidth="180"/>
                    </columns>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button text="Supprimer" onAction="#supprimer" styleClass="danger-button"/>
                    <Button text="Confirmer" onAction="#confirmerInscription" styleClass="success-button"/>
                    <Button text="Annuler" onAction="#annulerInscription" styleClass="warning-button"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
