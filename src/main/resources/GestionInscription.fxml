<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane"
            prefHeight="800.0"
            prefWidth="1200.0"
            styleClass="app-shell"
            stylesheets="@styles/gaming-theme.css"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.esprit.controllers.GestionInscriptionController">

    <left>
        <VBox prefWidth="230" spacing="20" styleClass="sidebar">
            <padding>
                <Insets top="28" right="18" bottom="28" left="18"/>
            </padding>
            <VBox spacing="4">
                <Label text="Gamer App" styleClass="brand-title"/>
                <Label text="Registrations" styleClass="brand-subtitle"/>
            </VBox>
            <VBox spacing="8">
                <Button maxWidth="Infinity" text="Evenements" onAction="#retour" styleClass="nav-button"/>
                <Button maxWidth="Infinity" text="Inscriptions" styleClass="nav-button-active"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="18" styleClass="content">
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Gestion des inscriptions" styleClass="page-title"/>
                    <Label fx:id="lbEvenement" styleClass="page-subtitle"/>
                </VBox>
                <Button text="Retour" onAction="#retour" styleClass="secondary-button"/>
            </HBox>

            <VBox spacing="16" styleClass="glass-panel" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <HBox alignment="BOTTOM_LEFT" spacing="12">
                    <VBox spacing="6">
                        <Label text="Utilisateur ID" styleClass="form-label"/>
                        <TextField fx:id="tfUtilisateurId" prefWidth="260" promptText="Ex: 42"/>
                    </VBox>
                    <Button text="Inscrire" onAction="#inscrire" styleClass="primary-button"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Statut ajoute automatiquement : En attente" styleClass="muted-label"/>
                </HBox>

                <TableView fx:id="tableInscriptions" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="0" visible="false"/>
                        <TableColumn fx:id="colUtilisateurId" text="Utilisateur ID" prefWidth="0" visible="false"/>
                        <TableColumn fx:id="colDateInscription" text="Date inscription" prefWidth="240"/>
                        <TableColumn fx:id="colStatut" text="Statut" prefWidth="180"/>
                    </columns>
                </TableView>

            </VBox>
        </VBox>
    </center>
</BorderPane>
