<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Controller.MainController"
            stylesheets="@../style.css" styleClass="main-background">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-background-color: #0d1c2d; -fx-border-color: rgba(189, 0, 255, 0.2); -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets left="20" right="20"/>
            </padding>

            <!-- LEFT: Logo -->
            <Label text="TEAM HUB" styleClass="logo-text" />

            <!-- Spacer to push search to middle -->
            <Region HBox.hgrow="ALWAYS" />

            <!-- CENTER: Search Bar + Filters -->
            <VBox alignment="CENTER" spacing="8" styleClass="search-container">
                <HBox alignment="CENTER" spacing="10">
                    <TextField fx:id="searchBar" promptText="Search for players, teams or tags..."
                               prefWidth="400.0" styleClass="dark-search-bar" />
                    <Button fx:id="searchButton" text="🔍" onAction="#handleSearch" styleClass="search-button" />
                </HBox>
                <HBox fx:id="filterBar" alignment="CENTER" spacing="10" visible="false" managed="false" styleClass="filter-bar">
                    <ComboBox fx:id="filterTime" promptText="Time" prefWidth="120" styleClass="filter-combo" />
                    <ComboBox fx:id="filterGameTag" promptText="Game Tag" prefWidth="140" styleClass="filter-combo" />
                    <ComboBox fx:id="filterType" promptText="Type" prefWidth="110" styleClass="filter-combo" />
                    <Button text="Apply" onAction="#applyFilters" styleClass="filter-apply-btn" />
                    <Button text="Clear" onAction="#clearFilters" styleClass="filter-clear-btn" />
                </HBox>
            </VBox>

            <!-- Spacer to push profile/icons to the right -->
            <Region HBox.hgrow="ALWAYS" />

            <!-- RIGHT: Icons and Profile -->
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
                <children>
                    <!-- Messagerie Button -->
                    <Button mnemonicParsing="false" onAction="#handleMessages" styleClass="icon-button" text="&#128488;" />

                    <!-- Notifications Button with Red Dot -->
                    <StackPane>
                        <children>
                            <Button mnemonicParsing="false" onAction="#handleNotifications" styleClass="icon-button" text="🔔" />
                            <Circle fill="#ff4b4b" radius="4.0" StackPane.alignment="TOP_RIGHT">
                                <StackPane.margin>
                                    <Insets right="5.0" top="5.0" />
                                </StackPane.margin>
                            </Circle>
                        </children>
                    </StackPane>

                    <!-- Parametres Button -->
                    <Button mnemonicParsing="false" onAction="#handleSettings" styleClass="icon-button" text="⚙" />

                    <!-- Vertical Separator -->
                    <Region prefHeight="30.0" prefWidth="1.0" style="-fx-background-color: rgba(255,255,255,0.1);" />

                    <!-- User Profile -->
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <children>
                            <VBox alignment="CENTER_RIGHT">
                                <children>
                                    <Label fx:id="headerUsernameLabel" text="Player_One" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;" />
                                    <Label text="Online" style="-fx-text-fill: #00ff88; -fx-font-size: 10px;" />
                                </children>
                            </VBox>
                            <StackPane fx:id="headerAvatarStack" style="-fx-cursor: hand;" onMouseClicked="#handleChangeProfilePhoto">
                                <Circle radius="18.0" fill="#1e293b" stroke="#00eefc" strokeType="INSIDE" strokeWidth="1.5" />
                                <ImageView fx:id="headerAvatarImage" />
                            </StackPane>
                        </children>
                    </HBox>
                </children>
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox spacing="10" styleClass="sidebar">
            <Button text="🏠 Home" onAction="#handleHome" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button text="📋 My Posts" onAction="#handleMyPosts" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button text="🌍 Explore" onAction="#handleExplore" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button text="🏆 Tournaments" onAction="#handleTournaments" styleClass="sidebar-button" maxWidth="Infinity" />
        </VBox>
    </left>

    <center>
        <ScrollPane fx:id="scrollArea" fitToWidth="true" prefHeight="800" prefWidth="600"
                    style="-fx-background: transparent; -fx-background-color: transparent;">
            <content>
                <VBox fx:id="mainWrapper" spacing="15" alignment="TOP_CENTER" style="-fx-padding: 30 50 30 50;">

                    <VBox spacing="10"
                          style="-fx-background-color: #1e293b; -fx-padding: 20; -fx-background-radius: 15; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 15;">

                        <HBox spacing="15" alignment="CENTER">
                            <TextArea fx:id="postInput"
                                      promptText="What's happening?"
                                      prefHeight="80"
                                      HBox.hgrow="ALWAYS"
                                      style="-fx-control-inner-background: #051424; -fx-text-fill: white; -fx-prompt-text-fill: #64748b; -fx-background-radius: 10;" />
                        </HBox>

                        <VBox fx:id="mediaPreviewContainer" spacing="5" />

                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Button text="Media"
                                    onAction="#handleMedia"
                                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-cursor: hand;" />

                            <ComboBox fx:id="gameTagSelector"
                                      promptText="Game Tag"
                                      style="-fx-background-color: #051424; -fx-text-fill: white;" />

                            <Region HBox.hgrow="ALWAYS" /> <Button text="Post"
                                                                   onAction="#handleCreatePost"
                                                                   style="-fx-background-color: #bd00ff; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 25 8 25;" />
                        </HBox>
                    </VBox>

                    <VBox fx:id="feedContainer" spacing="25" alignment="TOP_CENTER" />

                </VBox>
            </content>
        </ScrollPane>
    </center>
    <right>
        <VBox prefWidth="230.0" spacing="25.0" styleClass="sidebar"
              style="-fx-border-width: 0 0 0 1; -fx-background-color: #051424;">
            <padding>
                <Insets top="30.0" right="20.0" bottom="20.0" left="20.0" />
            </padding>

            <VBox fx:id="leaderboardContainer" spacing="15.0">
                <Label text="LEADERBOARD"
                       style="-fx-text-fill: #00eefc; -fx-font-weight: bold; -fx-font-size: 11px; -fx-letter-spacing: 1.5;" />
                <VBox spacing="8.0" fx:id="leaderboardList" />
            </VBox>

            <Region prefHeight="1" style="-fx-background-color: rgba(255,255,255,0.05);" />

            <VBox spacing="15.0" style="-fx-background-color: rgba(255,255,255,0.03); -fx-background-radius: 10; -fx-padding: 15;">
                <Label text="TRENDING GAMES"
                       style="-fx-text-fill: #bd00ff; -fx-font-weight: bold; -fx-font-size: 11px; -fx-letter-spacing: 1.5;" />

                <VBox spacing="10.0">
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="trending-item">
                        <Label text="1" style="-fx-text-fill: #64748b; -fx-font-weight: bold;" />
                        <VBox>
                            <Label text="League of Legends" styleClass="player-name" />
                            <Label text="2.4k Posts" style="-fx-text-fill: #64748b; -fx-font-size: 9px;" />
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="trending-item">
                        <Label text="2" style="-fx-text-fill: #64748b; -fx-font-weight: bold;" />
                        <VBox>
                            <Label text="Valorant" styleClass="player-name" />
                            <Label text="1.8k Posts" style="-fx-text-fill: #64748b; -fx-font-size: 9px;" />
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </right>
</BorderPane>