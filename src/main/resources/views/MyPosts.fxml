<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Controller.MyPostsController"
            stylesheets="@../style.css" styleClass="main-background">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-background-color: #0d1c2d; -fx-border-color: rgba(189, 0, 255, 0.2); -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets left="20" right="20"/>
            </padding>

            <Label text="TEAM HUB" styleClass="logo-text" />

            <Region HBox.hgrow="ALWAYS" />

            <Label text="Manage Your Posts" style="-fx-text-fill: #00eefc; -fx-font-size: 18px; -fx-font-weight: bold;" />

            <Region HBox.hgrow="ALWAYS" />

            <Button text="← Back to Feed" onAction="#handleBack"
                    style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 25 8 25;" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" prefHeight="800" prefWidth="600"
                    style="-fx-background: transparent; -fx-background-color: transparent;">
            <content>
                <VBox fx:id="myPostsContainer" spacing="25" alignment="TOP_CENTER" style="-fx-padding: 30 50 30 50;">

                    <Label fx:id="emptyLabel" text="You haven't posted anything yet."
                           style="-fx-text-fill: #64748b; -fx-font-size: 16px; -fx-padding: 50 0;"
                           visible="false" managed="false" />

                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
