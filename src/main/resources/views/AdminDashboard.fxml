<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Controller.AdminDashboardController"
            prefWidth="1100" prefHeight="700"
            styleClass="app-shell"
            stylesheets="@../styles/gaming-theme.css">

    <left>
        <VBox spacing="8" styleClass="sidebar" prefWidth="220">
            <padding><Insets top="24" right="14" bottom="20" left="14"/></padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <StackPane styleClass="brand-mark">
                    <Label text="TH" styleClass="brand-mark-text"/>
                </StackPane>
                <VBox>
                    <Label text="TEAM HUB" styleClass="brand-title"/>
                    <Label text="E-Sport Platform" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>
            <Region prefHeight="18"/>
            <Button text="🏠  Home" onAction="#handleHome" styleClass="nav-button" maxWidth="Infinity"/>
            <Button text="📋  My Posts" onAction="#handleMyPosts" styleClass="nav-button" maxWidth="Infinity"/>
            <Button text="📢  Annonces" onAction="#handleAnnonces" styleClass="nav-button" maxWidth="Infinity"/>
            <Button text="📅  Evenements" onAction="#handleEvenements" styleClass="nav-button" maxWidth="Infinity"/>
            <Button text="🛒  Marketplace" onAction="#handleMarketplace" styleClass="nav-button" maxWidth="Infinity"/>
            <Region prefHeight="18"/>
            <Button text="👤  Profile" onAction="#handleProfile" styleClass="nav-button" maxWidth="Infinity"/>
            <Button fx:id="adminButton" text="🔧  Admin" onAction="#handleAdmin" styleClass="nav-button-active" maxWidth="Infinity"/>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox spacing="8" styleClass="glass-panel">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                <Label text="MODE E-SPORT" style="-fx-text-fill: #d8b4fe; -fx-font-size: 10px; -fx-font-weight: 800;"/>
                <Label text="Stay competitive, track your stats &amp; rank up." wrapText="true"
                       style="-fx-text-fill: #9ca9c6; -fx-font-size: 11px;"/>
            </VBox>
            <Region prefHeight="10"/>
            <Button text="🚪  Logout" onAction="#handleLogout" styleClass="nav-button" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="15" style="-fx-padding: 25 30;">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="⚙ Admin Dashboard" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox spacing="20">
                <VBox spacing="10"
                      style="-fx-background-color: #0d1c2d; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: rgba(0,229,255,0.15); -fx-border-radius: 12; -fx-pref-width: 200;">
                    <Label text="Total Users" style="-fx-text-fill: #7a8899; -fx-font-size: 11px;"/>
                    <Label fx:id="totalUsersLabel" text="0" style="-fx-text-fill: #00E5FF; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                </VBox>
                <VBox spacing="10"
                      style="-fx-background-color: #0d1c2d; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: rgba(189,0,255,0.15); -fx-border-radius: 12; -fx-pref-width: 200;">
                    <Label text="Total Posts" style="-fx-text-fill: #7a8899; -fx-font-size: 11px;"/>
                    <Label fx:id="totalPostsLabel" text="0" style="-fx-text-fill: #bd00ff; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <Label text="USERS" style="-fx-text-fill: #4fc3f7; -fx-font-size: 14px; -fx-font-weight: bold;"/>
            <ScrollPane fitToWidth="true" prefHeight="200"
                        style="-fx-background: transparent; -fx-background-color: transparent;">
                <content>
                    <VBox fx:id="usersContainer" spacing="8" style="-fx-padding: 5 0;"/>
                </content>
            </ScrollPane>

            <Label text="AUDIT LOG" style="-fx-text-fill: #ffd700; -fx-font-size: 14px; -fx-font-weight: bold;"/>
            <ScrollPane fitToWidth="true" prefHeight="200"
                        style="-fx-background: transparent; -fx-background-color: transparent;">
                <content>
                    <VBox fx:id="auditContainer" spacing="6" style="-fx-padding: 5 0;"/>
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
