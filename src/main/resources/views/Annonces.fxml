<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1300.0" styleClass="app-shell"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Controller.AnnonceController"
            stylesheets="@../styles/gaming-theme.css, @../style.css">
    <left>
        <VBox spacing="8" styleClass="sidebar" prefWidth="220">
            <padding><Insets top="24" right="14" bottom="20" left="14"/></padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <StackPane styleClass="brand-mark">
                    <Label text="TH" styleClass="brand-mark-text"/>
                </StackPane>
                <VBox>
                    <Label text="TEAM HUB" styleClass="brand-title"/>
                    <Label text="E-Sport Platform" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>
            <Region prefHeight="18"/>
            <Button text="🏠  Home" onAction="#handleHome" styleClass="nav-button" maxWidth="Infinity"/>
            <Button text="📋  My Posts" onAction="#handleMyPosts" styleClass="nav-button" maxWidth="Infinity"/>
            <Button text="📢  Annonces" onAction="#handleAnnonces" styleClass="nav-button-active" maxWidth="Infinity"/>
            <Button text="📅  Evenements" onAction="#handleEvenements" styleClass="nav-button" maxWidth="Infinity"/>
            <Button text="🛒  Marketplace" onAction="#handleMarketplace" styleClass="nav-button" maxWidth="Infinity"/>
            <Region prefHeight="18"/>
            <Button text="👤  Profile" onAction="#handleProfile" styleClass="nav-button" maxWidth="Infinity"/>
            <Button fx:id="adminButton" text="🔧  Admin" onAction="#handleAdmin" styleClass="nav-button" maxWidth="Infinity"/>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox spacing="8" styleClass="glass-panel">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                <Label text="MODE E-SPORT" style="-fx-text-fill: #d8b4fe; -fx-font-size: 10px; -fx-font-weight: 800;"/>
                <Label text="Stay competitive, track your stats &amp; rank up." wrapText="true"
                       style="-fx-text-fill: #9ca9c6; -fx-font-size: 11px;"/>
            </VBox>
            <Region prefHeight="10"/>
            <Button text="🚪  Logout" onAction="#handleLogout" styleClass="nav-button" maxWidth="Infinity"/>
        </VBox>
    </left>
    <top>
        <VBox spacing="12.0" styleClass="gaming-header">
            <padding>
                <Insets bottom="16.0" left="28.0" right="28.0" top="20.0" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Region HBox.hgrow="ALWAYS"/>
                <Label styleClass="gaming-title" text="Gestion des Annonces" />
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <TextField fx:id="tfRecherche" prefWidth="320.0" promptText="Rechercher par titre, description ou jeu"
                           style="-fx-background-color: #0d1117; -fx-text-fill: #e6edf3; -fx-prompt-text-fill: #8b949e; -fx-border-color: #30363d; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"/>
                <TextField fx:id="tfSalaireMin" prefWidth="120.0" promptText="Salaire min"
                           style="-fx-background-color: #0d1117; -fx-text-fill: #e6edf3; -fx-prompt-text-fill: #8b949e; -fx-border-color: #30363d; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"/>
                <TextField fx:id="tfSalaireMax" prefWidth="120.0" promptText="Salaire max"
                           style="-fx-background-color: #0d1117; -fx-text-fill: #e6edf3; -fx-prompt-text-fill: #8b949e; -fx-border-color: #30363d; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"/>
                <Button onAction="#rechercherAnnonce" styleClass="btn-primary" text="Rechercher" />
                <Button onAction="#ajouterAnnonce" styleClass="btn-primary" text="+ Nouvelle Annonce" />
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox alignment="TOP_CENTER" fillWidth="true" styleClass="gaming-content">
            <padding>
                <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
            </padding>
            <ListView fx:id="listAnnonces" prefHeight="620.0" prefWidth="1244.0" VBox.vgrow="ALWAYS" />
        </VBox>
    </center>
</BorderPane>
