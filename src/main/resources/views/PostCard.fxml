<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>

<VBox spacing="15.0" styleClass="glass-card" stylesheets="@../style.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.Controller.PostCardController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <StackPane>
            <Circle radius="20.0" fill="#2c3a4c" stroke="#00eefc" strokeWidth="1.5" />
            <ImageView fx:id="userAvatarImage" fitWidth="40" fitHeight="40" preserveRatio="true" />
        </StackPane>
        <VBox spacing="2.0">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label fx:id="userNameLabel" text="GhostProtocol_" styleClass="user-name" />
                <Label fx:id="trendingBadge" text="🔥 HOT" styleClass="trending-badge" visible="false" managed="false" />
            </HBox>
            <HBox spacing="8.0" alignment="CENTER_LEFT">
                <Label fx:id="gameTagLabel" text="VALORANT" styleClass="game-tag-badge" />
                <Label fx:id="postDateLabel" text="2h ago" style="-fx-text-fill: #64748b; -fx-font-size: 11px;" />
            </HBox>
        </VBox>
    </HBox>

    <Label fx:id="contentLabel" wrapText="true" styleClass="post-content"
           text="Just reached Platinum III! The visual fidelity in this update is insane. 🚀" />

    <VBox fx:id="imageContainer" visible="false" managed="false" alignment="CENTER" spacing="5">
        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="prevImageBtn" text="◀" onAction="#prevImage" visible="false" managed="false" styleClass="image-nav-btn" />
            <VBox alignment="CENTER" spacing="5">
                <ImageView fx:id="postImageView" fitHeight="300" fitWidth="500" preserveRatio="true" />
                <Label fx:id="imageCounter" text="1 / 1" visible="false" managed="false" style="-fx-text-fill: #64748b; -fx-font-size: 11px;" />
            </VBox>
            <Button fx:id="nextImageBtn" text="▶" onAction="#nextImage" visible="false" managed="false" styleClass="image-nav-btn" />
        </HBox>
    </VBox>

    <Region prefHeight="1.0" style="-fx-background-color: rgba(255,255,255,0.1);" />

    <HBox spacing="15.0" alignment="CENTER_LEFT">
        <HBox spacing="5" alignment="CENTER_LEFT">
            <Button fx:id="likeButton" onAction="#handleLike" text="👍" styleClass="action-button" />
            <Label fx:id="likeCountLabel" text="0" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;" />
        </HBox>
        <Button fx:id="commentsButton" onAction="#toggleComments" styleClass="action-button">
            <text>💬 Comments</text>
        </Button>
        <Region HBox.hgrow="ALWAYS" />
        <HBox spacing="5" alignment="CENTER_LEFT">
            <Button fx:id="shareButton" onAction="#handleShare" text="&#x267B;" styleClass="action-button" />
            <Label fx:id="shareCountLabel" text="0" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;" />
        </HBox>
    </HBox>

    <HBox fx:id="editActions" spacing="15.0" alignment="CENTER_RIGHT" visible="false" managed="false">
        <Region HBox.hgrow="ALWAYS" />
        <Button text="✏ Edit" onAction="#handleEdit"
                style="-fx-background-color: #2c3a4c; -fx-text-fill: #00eefc; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 25 8 25;" />
        <Button text="🗑 Delete" onAction="#handleDelete"
                style="-fx-background-color: #ff4b4b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 25 8 25;" />
    </HBox>

    <VBox fx:id="commentsSection" visible="false" managed="false" spacing="10.0"
          style="-fx-background-color: #0d1c2d; -fx-background-radius: 10; -fx-padding: 15; -fx-border-color: rgba(255,255,255,0.05); -fx-border-radius: 10;">

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;"
                    prefHeight="200.0">
            <content>
                <VBox fx:id="commentsList" spacing="8.0" />
            </content>
        </ScrollPane>

        <Separator style="-fx-background-color: rgba(255,255,255,0.1);" />

        <HBox spacing="10.0" alignment="CENTER_LEFT">
        <StackPane>
            <Circle radius="14.0" fill="#2c3a4c" stroke="#00eefc" strokeWidth="1.0" />
            <ImageView fx:id="commentAvatarImage" fitWidth="28" fitHeight="28" preserveRatio="true" />
        </StackPane>
            <TextField fx:id="commentInput" promptText="Write a comment..."
                       HBox.hgrow="ALWAYS"
                       style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-prompt-text-fill: #64748b; -fx-background-radius: 20; -fx-padding: 5 15 5 15;" />
            <Button text="Fix" onAction="#handleFixComment"
                    style="-fx-background-color: #1e3a5f; -fx-text-fill: #4fc3f7; -fx-font-weight: bold; -fx-background-radius: 15; -fx-padding: 4 12 4 12; -fx-cursor: hand; -fx-font-size: 11px;" />
            <Button text="Send" onAction="#handleAddComment"
                    style="-fx-background-color: #bd00ff; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 6 20 6 20;" />
        </HBox>
    </VBox>
</VBox>