<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.Controller.ForgotPasswordController"
           prefWidth="1000" prefHeight="700"
           style="-fx-background-color: #050814;">

    <VBox alignment="CENTER" spacing="20"
          style="-fx-background-color: rgba(8,12,26,0.95); -fx-background-radius: 14; -fx-border-color: #1e2d45; -fx-border-radius: 14; -fx-border-width: 1; -fx-max-width: 420; -fx-padding: 40;">

        <Label text="🔐" style="-fx-font-size: 36px;"/>
        <Label text="Reset Password" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>

        <VBox fx:id="step1Box" spacing="15" alignment="CENTER" visible="true" managed="true">
            <Label text="Enter your email to receive a reset code."
                   wrapText="true" style="-fx-text-fill: #5a6478; -fx-font-size: 12px; -fx-text-alignment: center;"/>
            <TextField fx:id="emailField" promptText="your@email.com" prefWidth="340" maxWidth="340"
                       style="-fx-background-color: #12192e; -fx-text-fill: #dde4f0; -fx-prompt-text-fill: #3d4a5c; -fx-border-color: #243044; -fx-border-radius: 7; -fx-background-radius: 7; -fx-padding: 12 14;"/>
            <Button text="Send Reset Code" onAction="#handleSendReset" prefWidth="340" maxWidth="340"
                    style="-fx-background-color: #00E5FF; -fx-text-fill: #050814; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 13; -fx-cursor: hand;"/>
        </VBox>

        <VBox fx:id="step2Box" spacing="15" alignment="CENTER" visible="false" managed="false">
            <Label text="Check your email for the reset code and enter it below."
                   wrapText="true" style="-fx-text-fill: #5a6478; -fx-font-size: 12px; -fx-text-alignment: center;"/>
            <Label fx:id="tokenDisplayLabel" text="" wrapText="true" textAlignment="CENTER"
                   style="-fx-text-fill: #00E5FF; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: rgba(0,229,255,0.08); -fx-background-radius: 6; -fx-padding: 10 14; -fx-max-width: 340;"/>
            <TextField fx:id="tokenField" promptText="Reset code" prefWidth="340" maxWidth="340"
                       style="-fx-background-color: #12192e; -fx-text-fill: #dde4f0; -fx-prompt-text-fill: #3d4a5c; -fx-border-color: #243044; -fx-border-radius: 7; -fx-background-radius: 7; -fx-padding: 12 14;"/>
            <PasswordField fx:id="newPasswordField" promptText="New password" prefWidth="340" maxWidth="340"
                           style="-fx-background-color: #12192e; -fx-text-fill: #dde4f0; -fx-prompt-text-fill: #3d4a5c; -fx-border-color: #243044; -fx-border-radius: 7; -fx-background-radius: 7; -fx-padding: 12 14;"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm password" prefWidth="340" maxWidth="340"
                           style="-fx-background-color: #12192e; -fx-text-fill: #dde4f0; -fx-prompt-text-fill: #3d4a5c; -fx-border-color: #243044; -fx-border-radius: 7; -fx-background-radius: 7; -fx-padding: 12 14;"/>
            <Button text="Reset Password" onAction="#handleResetPassword" prefWidth="340" maxWidth="340"
                    style="-fx-background-color: #bd00ff; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 13; -fx-cursor: hand;"/>
        </VBox>

        <Label fx:id="errorLabel" text="" wrapText="true" visible="false" managed="false"
               style="-fx-text-fill: #ff4d4d; -fx-font-size: 11px; -fx-background-color: rgba(255,77,77,0.08); -fx-background-radius: 6; -fx-padding: 6 10;"/>
        <Label fx:id="successLabel" text="" wrapText="true" visible="false" managed="false"
               style="-fx-text-fill: #22c55e; -fx-font-size: 11px; -fx-background-color: rgba(34,197,94,0.08); -fx-background-radius: 6; -fx-padding: 6 10;"/>

        <Button text="← Back to Login" onAction="#goToLogin"
                style="-fx-background-color: transparent; -fx-text-fill: #00E5FF; -fx-font-size: 12px; -fx-cursor: hand; -fx-underline: true;"/>
    </VBox>
</StackPane>
