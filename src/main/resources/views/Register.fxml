<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.Controller.RegisterController"
           prefWidth="1000" minWidth="1000" maxWidth="1000"
           prefHeight="700" minHeight="700" maxHeight="700"
           style="-fx-background-color: #050814;">

    <VBox StackPane.alignment="CENTER"
          alignment="CENTER"
          spacing="0"
          prefWidth="380" minWidth="380" maxWidth="380"
          style="-fx-background-color: rgba(8,12,26,0.95);
                 -fx-background-radius: 14;
                 -fx-border-color: #1e2d45;
                 -fx-border-radius: 14;
                 -fx-border-width: 1;">

        <VBox alignment="CENTER" spacing="6"
              style="-fx-padding: 24 36 16 36;">
            <StackPane prefWidth="48" prefHeight="48" maxWidth="48" maxHeight="48"
                       style="-fx-background-color: #00E5FF; -fx-background-radius: 9;">
                <Label text="✦" style="-fx-text-fill: #050814; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            </StackPane>
            <Label text="TEAM HUB"
                   style="-fx-text-fill: #00E5FF; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Label text="ELITE ESPORTS COMMAND"
                   style="-fx-text-fill: #5a6478; -fx-font-size: 9px;"/>
        </VBox>

        <Region prefHeight="1" prefWidth="380" style="-fx-background-color: #1a2d42;"/>

        <VBox spacing="8" style="-fx-padding: 20 36 20 36;">
            <Label text="Create Account"
                   style="-fx-text-fill: #eef2f7; -fx-font-size: 19px; -fx-font-weight: bold;">
                <VBox.margin><Insets bottom="1"/></VBox.margin>
            </Label>
            <Label text="Join the professional scouting network"
                   style="-fx-text-fill: #5a6478; -fx-font-size: 12px;">
                <VBox.margin><Insets bottom="10"/></VBox.margin>
            </Label>

            <Label text="USERNAME"
                   style="-fx-text-fill: #7a8899; -fx-font-size: 10px; -fx-font-weight: bold;"/>
            <TextField fx:id="usernameField"
                       promptText="e.g. ProPlayer42"
                       prefWidth="308" maxWidth="308"
                       style="-fx-background-color: #12192e;
                              -fx-text-fill: #dde4f0; -fx-prompt-text-fill: #3d4a5c;
                              -fx-border-color: #243044;
                              -fx-border-radius: 7; -fx-background-radius: 7;
                              -fx-padding: 11 14; -fx-font-size: 13px;"/>

            <Label text="EMAIL ADDRESS"
                   style="-fx-text-fill: #7a8899; -fx-font-size: 10px; -fx-font-weight: bold;">
                <VBox.margin><Insets top="3"/></VBox.margin>
            </Label>
            <TextField fx:id="emailField"
                       promptText="name@organization.com"
                       prefWidth="308" maxWidth="308"
                       style="-fx-background-color: #12192e;
                              -fx-text-fill: #dde4f0; -fx-prompt-text-fill: #3d4a5c;
                              -fx-border-color: #243044;
                              -fx-border-radius: 7; -fx-background-radius: 7;
                              -fx-padding: 11 14; -fx-font-size: 13px;"/>

            <Label text="PASSWORD"
                   style="-fx-text-fill: #7a8899; -fx-font-size: 10px; -fx-font-weight: bold;">
                <VBox.margin><Insets top="3"/></VBox.margin>
            </Label>
            <PasswordField fx:id="passwordField"
                           promptText="••••••••"
                           prefWidth="308" maxWidth="308"
                           style="-fx-background-color: #12192e;
                                  -fx-text-fill: #dde4f0; -fx-prompt-text-fill: #3d4a5c;
                                  -fx-border-color: #243044;
                                  -fx-border-radius: 7; -fx-background-radius: 7;
                                  -fx-padding: 11 14; -fx-font-size: 13px;"/>

            <Label text="PRIMARY ROLE"
                   style="-fx-text-fill: #7a8899; -fx-font-size: 10px; -fx-font-weight: bold;">
                <VBox.margin><Insets top="3"/></VBox.margin>
            </Label>
            <ChoiceBox fx:id="roleChoiceBox"
                       prefWidth="308" maxWidth="308"
                       style="-fx-background-color: #12192e;
                              -fx-mark-color: #00E5FF;
                              -fx-text-fill: #dde4f0;
                              -fx-border-color: #243044;
                              -fx-border-radius: 7; -fx-background-radius: 7;
                              -fx-padding: 6 10; -fx-font-size: 13px;"/>

            <Label fx:id="errorLabel"
                   text=""
                   wrapText="true"
                   maxWidth="308"
                   visible="false" managed="false"
                   style="-fx-text-fill: #ff4d4d; -fx-font-size: 11px;
                          -fx-background-color: rgba(255,77,77,0.08);
                          -fx-background-radius: 6; -fx-padding: 6 10;">
                <VBox.margin><Insets top="2"/></VBox.margin>
            </Label>

            <Button text="Complete Registration"
                    onAction="#handleRegister"
                    prefWidth="308" maxWidth="308"
                    style="-fx-background-color: #00E5FF;
                           -fx-text-fill: #050814;
                           -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-background-radius: 7; -fx-cursor: hand;
                           -fx-padding: 12 0;
                           -fx-effect: dropshadow(gaussian,#00E5FFAA,18,0.5,0,2);">
                <VBox.margin><Insets top="4"/></VBox.margin>
            </Button>

            <HBox alignment="CENTER" style="-fx-padding: 4 0 0 0;">
                <Label text="Already have an account? "
                       style="-fx-text-fill: #5a6478; -fx-font-size: 12px;"/>
                <Button text="Sign in here" onAction="#goToLogin"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #00E5FF; -fx-font-size: 12px;
                               -fx-cursor: hand; -fx-underline: true;
                               -fx-padding: 0; -fx-border-color: transparent;"/>
            </HBox>
        </VBox>

        <Region prefHeight="1" prefWidth="380" style="-fx-background-color: #1a2d42;"/>

        <HBox alignment="CENTER" spacing="10" style="-fx-padding: 12 36;">
            <Label text="●" style="-fx-text-fill: #22c55e; -fx-font-size: 9px;"/>
            <Label text="Systems Online" style="-fx-text-fill: #3d4a5c; -fx-font-size: 9px;"/>
            <Label text="|" style="-fx-text-fill: #243044; -fx-font-size: 9px;"/>
            <Label text="Version 2.4.0-Pro" style="-fx-text-fill: #3d4a5c; -fx-font-size: 9px;"/>
        </HBox>
    </VBox>
</StackPane>
